### Plotting 2D non-decreasing density surface 

Plot2DRaw<- function( Tc.vec,N.vec, plotI=TRUE, nbin=15, 
                      nlevels = 10,
                      mains="Histogram with Monotonic Density",
                      xlab = "Censoring Time", ylab = "Sample Size" ){
  h <- hist2d( Tc.vec,N.vec, nbin=nbin, show=FALSE,xlab=xlab, ylab=ylab)
  z=h$count/sum(h$count)
  xlabs<-as.numeric(unlist(strsplit(  gsub("\\[|\\]|\\(|\\)", "",rownames(z)), ",")))
  ylabs<-as.numeric(unlist(strsplit(  gsub("\\[|\\]|\\(|\\)", "",colnames(z)), ",")))
  
  old_par<-par(mfrow = c(1,2))
  
  par(mar = c(1, 1, 0, 0))
  hist3D(x = seq(min(xlabs), max(xlabs), length.out = nrow(z)) ,
         y = seq(min(ylabs), max(ylabs), length.out = ncol(z)) , 
         z=z*1e3, border="black", contour =TRUE,
         phi = 30, theta = -40, r=1, cex.lab=0.8,
         ticktype = "detailed", cex.axis = 0.6, nticks = 5, 
         xlab = "\n Tc", ylab = "\n n", zlab = "\n Density (×10⁻³)",
         colkey = FALSE
  )
  par(mgp = c(1, 0.5, 0))
  par(mar = c(4.1, 2.1, 2.1, 1))
  # par(
  #   mar = c(5.1, 4.1, 4.1, 2.1),    # bottom, left, top, right margins (in lines)
  #   oma = c(0, 0, 0, 0)     # outer margins
  # )
  contour2D(x = seq(min(xlabs), max(xlabs), length.out = nrow(z)) ,
            y = seq(min(ylabs), max(ylabs), length.out = nrow(z)) , 
            xlab = "Tc", ylab = "\n n",
            z = z, lwd = 2, nlevels = 10,
            col="black",
            colkey = FALSE)
  abline(a = 300, b = -7.5)
  par(mar = c(5.1, 4.1, 4.1, 2.1))
  par(old_par)
  
  
}
 
Plot2DMonoDen<-function( Tc.vec,N.vec, plotI=TRUE, nbin=15, 
                         
                        mains="Histogram with Monotonic Density",
                        xlab = "Censoring Time", ylab = "Sample Size" ){
  ## 1 ─ histogram -------------------------------------------------
  h  <- hist2d(Tc.vec, N.vec, nbin = nbin, show = FALSE,
               xlab = xlab, ylab = ylab)
  x1 <- h$x;  x2 <- h$y
  grid <- expand.grid(x1 = x1, x2 = x2)
  y    <- c(h$counts / h$nobs)
  
  ## 2 ─ tensor-product B-splines ---------------------------------
  ## ---- basis definition (include 0 in boundaries) ----
  maxTc <- max(Tc.vec); maxN <- max(N.vec)
  b1 <- bs(grid$x1, df = 8, intercept = TRUE,
           Boundary.knots = c(0, maxTc))   # Tc basis
  b2 <- bs(grid$x2, df = 8, intercept = TRUE,
           Boundary.knots = c(0, maxN))    # n  basis)
  X  <- tensor.prod.model.matrix(list(b1, b2))
  ncoef <- ncol(X)
  ## ---- identify coefficients lying in the first row/col of 0  ----
  k1 <- ncol(b1)         # #basis fns in Tc direction
  k2 <- ncol(b2)         # #basis fns in n  direction
  coefMat <- matrix(seq_len(k1 * k2), k1, k2, byrow = TRUE)
  
  eq.idx <- unique(c(coefMat[1, ],            # row  i = 1  -> f(0, n) = 0
                     coefMat[, 1]))            # column j = 1 -> f(Tc,0)=0
  
  Ceq <- diag(ncoef)[eq.idx, , drop = FALSE]   # pick those rows
  ceq <- rep(0, length(eq.idx))
  ## 3 ─ quadratic roughness penalty ------------------------------
  D1 <- diff(diag(ncol(b1)), differences = 2)
  D2 <- diff(diag(ncol(b2)), differences = 2)
  S1 <- kronecker(diag(ncol(b2)), t(D1) %*% D1)
  S2 <- kronecker(t(D2) %*% D2, diag(ncol(b1)))
  S  <- list(S1 + S2)
  
  ## 4 ─ inequality constraints -----------------------------------
  ## 4a  monotone (Δ ≥ 0)
  A1m <- kronecker(diag(ncol(b2)), diff(diag(ncol(b1))))
  A2m <- kronecker(diff(diag(ncol(b2))), diag(ncol(b1)))
  ## 4b  concave (−Δ² ≥ 0)
  A1c <- kronecker(diag(ncol(b2)), -D1)
  A2c <- kronecker(-D2, diag(ncol(b1)))
  Ain <- rbind(A1m, A2m, A1c, A2c)
  bin <- rep(0, nrow(Ain))
  
  
  ## 5 ─ assemble pcls problem -----------------------------------
  M <- list(X = X, y = y, w = rep(1, length(y)),
            S = S, sp = 1, off = 0,
            Ain = Ain, bin = bin,
            C = Ceq,                 # << equality constraints
            c = ceq,                 # << zeros
            p = rep(0, ncoef), rank = ncoef)
  
  ## 6 ─ iteratively-reweighted fit -------------------------------
  coef_pcls <- pcls(M);        y_hat <- as.vector(X %*% coef_pcls)
  
  iter <- 0
  repeat {
    iter <- iter + 1
    M$w <- 1 / pmax(y_hat, 1e-9)            # avoid zero weights
    if (all(Ain %*% coef_pcls >= 0)) M$p <- coef_pcls
    new_coef <- pcls(M)
    if (max(abs(new_coef - coef_pcls)) < 1e-6 || iter >= 100) break
    coef_pcls <- new_coef
    y_hat     <- as.vector(X %*% coef_pcls)
  }
  y_hat <- as.vector(X %*% coef_pcls)
  
  # Fit model
  coef_pcls <- pcls(M)
  y_hat <- as.vector(X %*% coef_pcls)

  
if (plotI){

 z=h$count/sum(h$count)
xlabs<-as.numeric(unlist(strsplit(  gsub("\\[|\\]|\\(|\\)", "",rownames(z)), ",")))
ylabs<-as.numeric(unlist(strsplit(  gsub("\\[|\\]|\\(|\\)", "",colnames(z)), ",")))

old_par<-par(mfrow = c(1,2))


  
par(mgp = c(1, 0.5, 0))
par(mar = c(1, 1, 0, 0))
  
  
  # Plot the fitted surface
  zmat <- matrix(y_hat, length(x1), length(x2))
  persp3D(x1, x2, zmat*1e3, col = "lightblue", border = "black",
        ticktype = "detailed", cex.axis = 0.6, nticks = 5, lwd=0.1,
        xlab = "\n Tc", ylab = "\n n", zlab = "\n Rel.Shannon Info (×10⁻³)",
        theta= -30, phi=20 , r=5 )
  par(mar = c(4.1, 2.1, 2.1, 1))

  contour(
    x = x1,
    y = x2,
    z = zmat,
    nlevels = 15,
    col = "blue",
    lwd = 0.5,
    xlab = "Tc",
    ylab = "n"
    #, main = "Contour Lines of Fitted Shanon Information"
  )
  abline(a = 150, b = -7.5, col= "red")
  points(7.333,95,col="black",lwd=2)
  par(mar = c(5.1, 4.1, 4.1, 2.1))
  par(old_par)

}
  
  
  
  list(coef_pcls=coef_pcls,
       y_hat=y_hat,
       fit_func= function(w1,w2){
         B1_w <- predict(b1, w1)  # row vector (1 × k1)
         B2_w <- predict(b2, w2)  # row vector (1 × k2)
         
         # Tensor product of two row vectors: gives 1 × (k1 × k2)
         X_w <- tensor.prod.model.matrix(list(B1_w, B2_w))  # 1-row design matrix
         
           (X_w%*% coef_pcls)
       }  )
  
}

