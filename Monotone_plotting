### Plotting 1D non-decreasing density curve 

Plot1DMonoDen<-function(dat1, plotI=TRUE, breaks = "Sturges", 
                        mains="Histogram with Monotonic Density",
                        xlab = "Censoring Time"){
  ## 1 ─ histogram ----------------------------------------------------------
  h  <- hist(dat1, plot = plotI, breaks = breaks,col = "white",
             freq = FALSE, main = mains, xlab = xlab)
  x1 <- h$mids
  y  <- h$density
  maxx  <- max(dat1)
  ## 2 ─ B-spline basis -----------------------------------------------------
  X  <- bs(x1, df = 8, intercept = TRUE,
           Boundary.knots = c(0, maxx))   # <<< ensures 0 is inside range
  ncoef <- ncol(X)
  
  ## 3 ─ smoothness penalty (second-order diffs) ----------------------------
  D1 <- diff(diag(ncoef), differences = 2)
  S  <- list(t(D1) %*% D1)
  
  ## 4 ─ inequality constraints --------------------------------------------
  A_mono <- diff(diag(ncoef))                    # 1st diff ≥ 0  (monotone)
  A_conc <- -diff(diag(ncoef), differences = 2)  # -2nd diff ≥ 0  (concave)
  Ain    <- rbind(A_mono, A_conc)
  bin    <- rep(0, nrow(Ain))
  
  ## 5 ─ *new* equality constraint f(0) = 0 --------------------------------
  Ceq <- matrix(predict(X, 0), 1, ncoef)      # row basis at Tc = 0
  ceq <- 0
  
  ## 6 ─ assemble PCLS problem ---------------------------------------------
  M <- list(
    X   = X,
    y   = y,
    w   = rep(1, length(y)),
    S   = S,
    sp  = 1,
    off = c(0),
    Ain = Ain,
    bin = bin,
    C   = Ceq,        # <<<
    c   = ceq,        # <<<
    p   = rep(0, ncoef),
    rank = ncoef
  )
   
  ## 6 ─ iteratively re-weighted fitting (same as before) -------------------
  coef_pcls <- pcls(M)
  y_hat     <- as.vector(X %*% coef_pcls)
  
  count.i   <- 0
  old_pcls  <- coef_pcls + 1           # force first iteration
  while (sum(abs(old_pcls - coef_pcls)) > 1e-6 && count.i < 100) {
    old_pcls <- coef_pcls
    M$w      <- 1 / y_hat              # variance-stabilising weights
    if (all(Ain %*% coef_pcls >= 0))   # stay feasible
      M$p <- coef_pcls
    coef_pcls <- pcls(M)
    y_hat     <- as.vector(X %*% coef_pcls)
    count.i   <- count.i + 1
  }
  
  if (plotI) lines(x1, y_hat, col = "red", lwd = 1)
  
   
  list(
    coef_pcls = coef_pcls,
    y_hat     = y_hat,
    fit_func  = function(x) as.vector(predict(X, x) %*% coef_pcls)
  )
}
