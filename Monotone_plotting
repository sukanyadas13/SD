# -------------------------------------------------------
# Shannon-information objective  G(n, Tc) of Weibull with known shape kappa
# -------------------------------------------------------

G_n_Tc_1 <- function(n, Tc, alpha, beta, kappa = 1,
                   rel.tol = 1e-6, abs.tol = 0) {
  
  stopifnot(n >= 1, Tc > 0, alpha > 2, beta > 0, kappa > 0)
  
  #----- helper: D_r(t) ---------------------------------
  D_r <- function(t, r) {
    if (r == 0) return(0)
    coef <- choose(n, r) / factorial(r - 1)      # binom * 1/(r-1)!
    # vectorised inner sum over i = 0..r
    inner <- vapply(0:r, function(i)
      choose(r, i) * (-1)^i *
        pmax(0, t - Tc^kappa * (n - r + i))^(r - 1),  # pmax = max(0,·)
      numeric(length(t)))
    coef * rowSums(inner)
  }
  
  #----- closed-form first two terms --------------------
  term0 <- -alpha * beta^alpha * n * Tc^kappa /
    (beta + n * Tc^kappa)^(alpha + 1)
  term1 <- -alpha * beta^alpha /
    (beta + n * Tc^kappa)^alpha *
    log(beta / (beta + n * Tc^kappa))
  
  #----- integrand for a given r ------------------------
  integrand_r <- function(t, r) {
    Dr   <- D_r(t, r)
    core <- beta^alpha * exp(lgamma(alpha + r) - lgamma(alpha)) /
      (beta + t)^(alpha + r)
    bracket <- r * digamma(alpha + r) -
      t * (alpha + r) / (beta + t) -
      alpha * log(beta / (beta + t)) -
      (lgamma(alpha + r) - lgamma(alpha))
    Dr * core * bracket
  }
  
  #----- numerical integration over t -------------------
  upper <- n * Tc^kappa          # integrand = 0 beyond this
  int_sum <- 0
  for (r in 1:n) {
    int_sum <- int_sum +
      integrate(integrand_r, lower = 0, upper = upper,
                r = r, rel.tol = rel.tol, abs.tol = abs.tol)$value
  }
  
  term0 + term1 + int_sum
}

G_Tc <- function(n, Tc, alpha, beta, kappa = 1,
                   rel.tol = 1e-6, abs.tol = 0){ 
  sapply(Tc,  G_n_Tc_1, n=n, alpha=alpha, beta=beta, kappa=kappa,
                    rel.tol=rel.tol, abs.tol=abs.tol)
  
}

G_n <- function(n, Tc, alpha, beta, kappa = 1,
                 rel.tol = 1e-6, abs.tol = 0){ 
  sapply(n,  G_n_Tc_1, Tc=Tc, alpha=alpha, beta=beta, kappa=kappa,
         rel.tol=rel.tol, abs.tol=abs.tol)
}

