# -------------------------------------------------------
# Bayesian Fisher information of exponential
# -------------------------------------------------------

BFI<- function(n,Tc, alpha, beta,kappa=1){
 A<-alpha; B<-beta; N<-n
(B^2 - (B^A / ((Tc^kappa + B)^(A - 2)))) * (N / (A^2 - 3 * A + 2))
}

